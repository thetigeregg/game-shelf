{
  "name": "game-shelf",
  "version": "1.91.0",
  "author": "TigerEgg",
  "homepage": "https://github.com/thetigeregg/game-shelf",
  "scripts": {
    "prestart": "node scripts/generate-runtime-config.mjs && node scripts/generate-metacritic-platform-artifacts.mjs && node scripts/generate-mobygames-platform-artifacts.mjs",
    "ng": "ng",
    "prebuild": "node scripts/generate-runtime-config.mjs && node scripts/generate-metacritic-platform-artifacts.mjs && node scripts/generate-mobygames-platform-artifacts.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck:server": "npm --prefix server run typecheck",
    "test:server": "npm --prefix server test",
    "test:worker": "npm --prefix worker test",
    "test:backend": "npm run test:server && npm run test:worker",
    "test:backend:coverage": "npm --prefix server run test:coverage && npm --prefix worker run test:coverage",
    "test:watch": "vitest",
    "test:ui:component": "vitest run --config vitest.ui.config.ts",
    "test:ui:e2e": "npx playwright test",
    "test:ui": "npm run test:ui:component && npm run test:ui:e2e",
    "test:ui:e2e:install": "npx playwright install --with-deps chromium",
    "lint": "npx eslint .",
    "prepare": "husky",
    "deps:install:all": "npm ci && npm --prefix server ci && npm --prefix worker ci && npm --prefix hltb-scraper ci && npm --prefix metacritic-scraper ci && npm --prefix psprices-scraper ci && npm --prefix compat-scraper ci",
    "stack:recreate": "devx worktree stack down && devx worktree stack up",
    "generate:metacritic-platform-artifacts": "node scripts/generate-metacritic-platform-artifacts.mjs",
    "generate:mobygames-platform-artifacts": "node scripts/generate-mobygames-platform-artifacts.mjs",
    "generate:ios-info-plists": "node scripts/generate-ios-info-plists.mjs",
    "sync:ios:version": "node scripts/sync-ios-version.mjs --marketing-only",
    "backup:restore:postgres": "./scripts/backup/restore-postgres.sh",
    "test:backup:ops": "./scripts/backup/test-backup-flow.sh",
    "deps:angular:update": "ng update @angular/core @angular/cli",
    "deps:angular:ecosystem": "ng update @angular/cdk angular-eslint",
    "prebuild:ios:web": "node scripts/generate-runtime-config.mjs && node scripts/generate-metacritic-platform-artifacts.mjs && node scripts/generate-mobygames-platform-artifacts.mjs",
    "prebuild:ios": "node scripts/sync-ios-version.mjs --marketing-only && node scripts/generate-ios-info-plists.mjs && node scripts/bootstrap-ios-firebase-plists.mjs --required && npm run prebuild:ios:web",
    "prebuild:ios:local": "node scripts/write-environment-ios.mjs local && npm run prebuild:ios",
    "prebuild:ios:prod": "node scripts/write-environment-ios.mjs prod && npm run prebuild:ios",
    "prebuild:ios:ota": "node scripts/write-environment-ios.mjs prod && npm run prebuild:ios:web",
    "build:ios": "ng build --configuration ios-prod",
    "build:ios:local": "ng build --configuration ios-local",
    "build:ios:prod": "ng build --configuration ios-prod",
    "build:ios:prod:ota": "npm run prebuild:ios:ota && ng build --configuration ios-prod --output-path www/ios-ota",
    "sync:ios": "npm run sync:ios:prod",
    "sync:ios:local": "npm run build:ios:local && npx cap sync ios",
    "sync:ios:prod": "npm run build:ios:prod && npx cap sync ios",
    "list:ios:targets": "npx cap run ios --list",
    "open:ios": "npx cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/file-viewer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/inappbrowser": "^4.1.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@capawesome/capacitor-live-update": "^8.7.1",
    "@ionic/angular": "^9.0.10",
    "@playwright/test": "^1.65.0",
    "@semantic-icons/simple-icons": "^0.58.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-details": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "fake-indexeddb": "^6.2.7",
    "firebase": "^12.19.0",
    "ionicons": "^8.1.0",
    "ngx-tiptap": "^15.0.0",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.2",
    "swiper": "^14.4.0",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@capacitor/cli": "8.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ionic/angular-toolkit": "^13.0.0",
    "@thetigeregg/commitlint-config": "^2.0.3",
    "@thetigeregg/dev-cli": "^5.0.2",
    "@thetigeregg/lint-staged-config": "^2.0.0",
    "@thetigeregg/ncu-config": "^3.1.0",
    "@thetigeregg/prettier-config": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "23.1.1",
    "plist": "^5.0.0",
    "prettier": "3.9.10",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "description": "A game library tracker with metadata enrichment, manual lookup, and import workflows."
}
